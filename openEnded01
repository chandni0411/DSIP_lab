#x[n]=4u(n)−u(n−3)−5u(n−7)
import numpy as np
import matplotlib.pyplot as plt
n = np.arange(-2, 12)
u0 = (n >= 0).astype(int)
u3 = (n >= 3).astype(int)
u7 = (n >= 7).astype(int)
x = 4*u0 - u3 - 5*u7
plt.stem(n, x)
plt.xlabel('n')
plt.ylabel('x[n]')
plt.title('x[n] = 4u(n) - u(n-3) - 5u(n-7)')
plt.grid(True)
plt.show()

#. x[n]=δ(n)+3δ(n−1)+5δ(n+1)
import numpy as np
import matplotlib.pyplot as plt
n = np.arange(-5, 6)
x = np.zeros(len(n))
x[n == -1] = 5
x[n == 0] = 1
x[n == 1] = 3
plt.stem(n, x)
plt.xlabel('n')
plt.ylabel('x[n]')
plt.title('x[n] = δ(n) + 3δ(n-1) + 5δ(n+1)')
plt.grid(True)
plt.show()

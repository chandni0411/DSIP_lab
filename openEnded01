#periodic signal
import numpy as np
import matplotlib.pyplot as plt
n = np.arange(-3, 7)
x = np.zeros(len(n))
for i in range(len(n)):
    if n[i] % 2 == 0:
        x[i] = 3
    else:
        x[i] = 2
plt.stem(n, x)
plt.xlabel('n')
plt.ylabel('x[n]')
plt.title('Signal 1')
plt.grid(True)
plt.show()

#Piecewise_Signal
import numpy as np
import matplotlib.pyplot as plt
n = np.linspace(-3, 3, 1000)
x = np.zeros_like(n)
# x = -2 from -2 to -1
x[(n >= -2) & (n <= -1)] = -2
# Ramp from -1 to 1
mask = (n >= -1) & (n <= 1)
x[mask] = 2 * n[mask]
# x = 2 from 1 to 2
x[(n >= 1) & (n <= 2)] = 2
plt.plot(n, x, linewidth=2)
plt.axhline(0, color='black')
plt.axvline(0, color='black')
plt.xlim(-3, 3)
plt.ylim(-3, 3)
plt.xlabel('n')
plt.ylabel('x[n]')
plt.title('Signal 3')
plt.grid(True)
plt.show()

